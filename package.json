{
  "name": "optc-team-builder",
  "version": "0.0.61",
  "description": "Offline-first OPTC team builder, character database, and One Piece Treasure Cruise planning tools.",
  "homepage": "https://optcteambuilder.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnChourp/optc-team-builder.git"
  },
  "bugs": {
    "url": "https://github.com/JohnChourp/optc-team-builder/issues"
  },
  "keywords": [
    "optc",
    "one-piece-treasure-cruise",
    "team-builder",
    "character-database",
    "pirate-rumble"
  ],
  "scripts": {
    "config:app": "node ./scripts/write-app-config.mjs",
    "config:app:web-strict": "node ./scripts/write-app-config.mjs --require-google-web-client-id",
    "ng": "ng",
    "server:drive-sync": "node ./server/drive-sync-server.mjs",
    "start": "npm run config:app && ng serve",
    "build": "npm run config:app && ng build",
    "build:pages": "npm run config:app:web-strict && ng build --configuration production --base-href / && npm run seo:pages && npm run pwa:ngsw:pages && npm run seo:audit",
    "seo:pages": "node ./scripts/generate-seo-pages.mjs",
    "seo:audit": "node ./scripts/audit-seo-pages.mjs",
    "seo:indexnow": "node ./scripts/submit-indexnow.mjs",
    "pwa:ngsw:pages": "ngsw-config dist/optc-team-builder/browser ngsw-config.json /",
    "watch": "npm run config:app && ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:drive-sync-server": "vitest run server/drive-sync-server.spec.mjs",
    "test:e2e": "node ./scripts/run-playwright-e2e.mjs",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:chromium": "node ./scripts/run-playwright-e2e.mjs --e2e-project=chromium",
    "test:e2e:firefox": "node ./scripts/run-playwright-e2e.mjs --e2e-project=firefox",
    "test:e2e:webkit": "node ./scripts/run-playwright-e2e.mjs --e2e-project=webkit",
    "audit:dead-code": "npx tsc -p tsconfig.app.json --noEmit --noUnusedLocals --noUnusedParameters --pretty false && npx knip --include files,exports,types",
    "perf:dataset": "node ./scripts/benchmark-dataset.mjs",
    "i18n:extract": "../codex_utilities/Downloads/projects/node_modules/.bin/transloco-keys-manager extract --project optc-team-builder",
    "i18n:find": "../codex_utilities/Downloads/projects/node_modules/.bin/transloco-keys-manager find --project optc-team-builder --translations-path public/i18n",
    "i18n:validate": "node ./scripts/audit-i18n.mjs",
    "data:import:all": "node ./scripts/import-optc-data.mjs --download-images=all",
    "data:check-release": "node ./scripts/check-optc-release-needed.mjs",
    "data:apply-manual": "node ./scripts/apply-manual-characters.mjs",
    "data:upsert-manual-character": "node ./scripts/upsert-manual-character.mjs",
    "build:ionic": "npm run build",
    "build:mobile": "npm run build:ionic && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:sync": "npx cap sync android",
    "ios:sync": "npx cap sync ios"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "piscina": "5.2.0",
    "esbuild": "0.28.1",
    "jsdom": {
      "undici": "7.28.0"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.0.2",
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/service-worker": "^22.0.2",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.29",
    "@ionic/angular": "^8.8.11",
    "@jsverse/transloco": "^8.4.0",
    "ionicons": "^8.0.13",
    "lottie-web": "^5.13.0",
    "ngx-lottie": "^21.2.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.2",
    "@angular/cli": "^22.0.2",
    "@angular/compiler-cli": "^22.0.2",
    "@jsverse/transloco-utils": "^8.3.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
