{
  "name": "optc-team-builder",
  "version": "0.0.100",
  "description": "Offline-first OPTC team builder, character database, and One Piece Treasure Cruise planning tools.",
  "homepage": "https://optcteambuilder.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnChourp/optc-team-builder.git"
  },
  "bugs": {
    "url": "https://github.com/JohnChourp/optc-team-builder/issues"
  },
  "keywords": [
    "optc",
    "one-piece-treasure-cruise",
    "team-builder",
    "character-database",
    "pirate-rumble"
  ],
  "scripts": {
    "branch:cleanup-report": "node ./scripts/branch-cleanup-report.mjs",
    "config:app": "node ./scripts/write-app-config.mjs",
    "config:app:web-strict": "node ./scripts/write-app-config.mjs --require-google-web-client-id",
    "actions:pins": "node ./scripts/check-github-actions-pins.mjs",
    "actions:workflow-budgets": "node ./scripts/check-github-workflow-budgets.mjs",
    "ng": "ng",
    "server:drive-sync": "node ./server/drive-sync-server.mjs",
    "start": "npm run config:app && ng serve",
    "build": "npm run config:app && ng build",
    "build:pages": "npm run config:app:web-strict && ng build --configuration production --base-href / && npm run seo:pages && npm run pwa:ngsw:pages && npm run seo:audit",
    "seo:pages": "node ./scripts/generate-seo-pages.mjs",
    "seo:audit": "node ./scripts/audit-seo-pages.mjs",
    "discoverability:verify": "node ./scripts/verify-guide-discoverability.mjs",
    "synthetic:public-entry": "node ./scripts/public-entry-synthetics.mjs",
    "seo:indexnow": "node ./scripts/submit-indexnow.mjs",
    "pwa:ngsw:pages": "ngsw-config dist/optc-team-builder/browser ngsw-config.json /",
    "watch": "npm run config:app && ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:ci-routing": "vitest run scripts/ci-check-routing.spec.ts",
    "test:actions-pins": "vitest run scripts/check-github-actions-pins.spec.ts",
    "test:workflow-budgets": "vitest run scripts/check-github-workflow-budgets.spec.ts",
    "test:discoverability": "vitest run scripts/verify-guide-discoverability.spec.ts",
    "test:public-entry-synthetics": "vitest run scripts/public-entry-synthetics.spec.ts",
    "test:saved-team-codecs": "ng test --watch=false --include src/app/pages/saved-teams/saved-teams-transfer.utils.spec.ts --include src/app/pages/saved-teams/saved-teams-codec-fuzz.spec.ts --include src/app/pages/auto-team-builder/auto-team-builder-team-compare.utils.spec.ts --include src/app/pages/settings/all-data-transfer.utils.spec.ts",
    "test:captain-contracts": "vitest run scripts/import-optc-data.spec.ts scripts/lib/captain-ability-coverage.spec.ts",
    "test:release-check": "vitest run scripts/check-optc-release-needed.spec.ts scripts/check-optc-upstream-monitor.spec.ts scripts/backtest-optc-release-detector.spec.ts scripts/release-detector-status.spec.ts scripts/release-decision-history.spec.ts scripts/release-provenance-report.spec.ts scripts/post-dispatch-production-smoke.spec.ts",
    "test:release-runbook-drift": "vitest run scripts/check-release-runbook-drift.spec.ts",
    "test:drive-sync-server": "vitest run server/drive-sync-server.spec.mjs",
    "test:e2e": "node ./scripts/run-playwright-e2e.mjs",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:chromium": "node ./scripts/run-playwright-e2e.mjs --e2e-project=chromium",
    "test:e2e:firefox": "node ./scripts/run-playwright-e2e.mjs --e2e-project=firefox",
    "test:e2e:webkit": "node ./scripts/run-playwright-e2e.mjs --e2e-project=webkit",
    "test:public-entry-visual": "node ./scripts/run-playwright-e2e.mjs --e2e-project=chromium e2e/public-entry-visual.spec.ts",
    "test:post-merge-smoke": "npm run doctor:maintainer -- --profile=ci --brain-root ../optc-team-builder-brain && npm run data:check-release -- --fixture=no-change --json && npm run test:e2e:chromium -- --grep \"@post-merge-smoke\"",
    "test:e2e-triage": "vitest run scripts/lib/playwright-quarantine.spec.ts scripts/lib/playwright-e2e-runner.spec.ts scripts/summarize-playwright-failures.spec.ts && node ./scripts/validate-playwright-quarantine.mjs",
    "test:pwa-shell": "node ./scripts/pwa-shell-check.mjs",
    "audit:dead-code": "npx tsc -p tsconfig.app.json --noEmit --noUnusedLocals --noUnusedParameters --pretty false && npx knip --include files,exports,types",
    "perf:dataset": "node ./scripts/benchmark-dataset.mjs",
    "perf:ability-filters": "node ./scripts/perf-ability-filters.mjs",
    "perf:explanation-compare": "node ./scripts/perf-explanation-compare.mjs",
    "perf:saved-team-codecs": "node ./scripts/perf-saved-team-codecs.mjs",
    "perf:mobile-pickers": "node ./scripts/perf-mobile-pickers.mjs",
    "perf:memory-pressure": "node ./scripts/perf-memory-pressure.mjs",
    "perf:route-load": "node ./scripts/perf-route-load.mjs",
    "perf:budget-report": "node ./scripts/perf-budget-report.mjs",
    "perf:budget-history": "node ./scripts/perf-budget-history.mjs",
    "test:perf-budget": "node --check ./scripts/perf-route-load.mjs && node --check ./scripts/perf-saved-team-codecs.mjs && vitest run scripts/perf-budget-report.spec.ts scripts/perf-budget-history.spec.ts",
    "release:readiness": "node ./scripts/release-readiness-report.mjs",
    "test:release-readiness": "vitest run scripts/release-readiness-report.spec.ts",
    "release:detector-status": "node ./scripts/release-detector-status.mjs",
    "release:decision-history": "node ./scripts/release-decision-history.mjs",
    "release:provenance": "node ./scripts/release-provenance-report.mjs",
    "release:post-dispatch-smoke": "node ./scripts/post-dispatch-production-smoke.mjs",
    "doctor:maintainer": "node ./scripts/maintainer-environment-doctor.mjs",
    "test:maintainer-doctor": "vitest run scripts/maintainer-environment-doctor.spec.ts",
    "test:branch-cleanup": "vitest run scripts/branch-cleanup-report.spec.ts",
    "dataset:digest": "node ./scripts/dataset-change-digest.mjs",
    "test:dataset-digest": "vitest run scripts/dataset-change-digest.spec.ts",
    "test:docs-integrity": "vitest run scripts/check-docs-integrity.spec.ts",
    "docs:integrity": "node ./scripts/check-docs-integrity.mjs",
    "test:docs-drift": "vitest run scripts/check-docs-drift.spec.ts",
    "docs:drift": "node ./scripts/check-docs-drift.mjs",
    "test:docs-commands": "vitest run scripts/check-docs-commands.spec.ts",
    "docs:commands": "node ./scripts/check-docs-commands.mjs",
    "docs:release-runbook-drift": "node ./scripts/check-release-runbook-drift.mjs",
    "i18n:extract": "../codex_utilities/Downloads/projects/node_modules/.bin/transloco-keys-manager extract --project optc-team-builder",
    "i18n:find": "../codex_utilities/Downloads/projects/node_modules/.bin/transloco-keys-manager find --project optc-team-builder --translations-path public/i18n",
    "i18n:validate": "node ./scripts/audit-i18n.mjs",
    "i18n:regression": "node ./scripts/i18n-regression-check.mjs",
    "test:i18n-regression": "vitest run scripts/i18n-regression-check.spec.ts && npm run i18n:regression && npm run i18n:validate",
    "data:import:all": "node ./scripts/import-optc-data.mjs --download-images=all",
    "data:check-release": "node ./scripts/check-optc-release-needed.mjs",
    "data:monitor-upstream": "node ./scripts/check-optc-upstream-monitor.mjs",
    "data:backtest-release": "node ./scripts/backtest-optc-release-detector.mjs",
    "data:apply-manual": "node ./scripts/apply-manual-characters.mjs",
    "data:upsert-manual-character": "node ./scripts/upsert-manual-character.mjs",
    "build:ionic": "npm run build",
    "build:mobile": "npm run build:ionic && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:sync": "npx cap sync android",
    "ios:sync": "npx cap sync ios"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "piscina": "5.2.0",
    "esbuild": "0.28.1",
    "jsdom": {
      "undici": "7.28.0"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.0.5",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/router": "^22.0.5",
    "@angular/service-worker": "^22.0.5",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.34",
    "@ionic/angular": "^8.8.13",
    "@jsverse/transloco": "^8.4.0",
    "ionicons": "^8.0.13",
    "lottie-web": "^5.13.0",
    "ngx-lottie": "^22.0.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@axe-core/playwright": "^4.12.1",
    "@jsverse/transloco-utils": "^8.3.0",
    "@jsverse/transloco-validator": "^8.4.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
