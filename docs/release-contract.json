{
  "schemaVersion": 1,
  "note": "Generated by scripts/generate-release-contract.mjs. The version fields are MEASURED by bumping a fixture of the real tree, never hand-listed. Do not edit by hand.",
  "versionFields": [
    {
      "id": "android/app/build.gradle:versionCode",
      "file": "android/app/build.gradle",
      "key": "versionCode",
      "valueSites": 1,
      "rule": "strictly increasing integer, unrelated to the semantic version",
      "enforcedBy": "scripts/bump-version.sh refuses a --code that does not increase (869f13d7b)",
      "consumer": "Android, which accepts an install as an upgrade only when it increases",
      "breaksWhen": "it fails to increase - installed apps then silently refuse the update, which looks exactly like a broken updater"
    },
    {
      "id": "android/app/build.gradle:versionName",
      "file": "android/app/build.gradle",
      "key": "versionName",
      "valueSites": 1,
      "rule": "mirrors the semantic version exactly",
      "enforcedBy": "scripts/bump-version.sh",
      "consumer": "what Android shows in app info",
      "breaksWhen": "it drifts from the tag, so a player quoting it cannot be matched to a release"
    },
    {
      "id": "package-lock.json:version",
      "file": "package-lock.json",
      "key": "version",
      "valueSites": 2,
      "rule": "mirrors package.json, twice - the root object and packages[\"\"]",
      "enforcedBy": "npm version, which rewrites both",
      "consumer": "npm install resolution",
      "breaksWhen": "the lockfile is edited by hand and the two sites disagree"
    },
    {
      "id": "package.json:version",
      "file": "package.json",
      "key": "version",
      "valueSites": 1,
      "rule": "two-digit segments; no segment ever reaches three digits",
      "enforcedBy": "scripts/bump-version.sh, covered by scripts/bump-version.spec.ts",
      "consumer": "npm, and the release tag vX.Y.Z",
      "breaksWhen": "a hand-written --version puts a segment past 99, which the cap refuses"
    },
    {
      "id": "src/app/core/data/app-version.data.ts:APP_VERSION",
      "file": "src/app/core/data/app-version.data.ts",
      "key": "APP_VERSION",
      "valueSites": 1,
      "rule": "mirrors the semantic version; the bundle cannot read package.json",
      "enforcedBy": "scripts/bump-version.sh, which fails loudly if the constant is not found",
      "consumer": "the player, on the Settings \"App and data\" card, and the diagnostics export",
      "breaksWhen": "it goes stale, so Settings names the previous release"
    }
  ],
  "automaticOutputs": [
    {
      "id": "branch-push",
      "producer": "scripts/release-and-tag.sh",
      "signature": "git push origin \"${CURRENT_BRANCH}\"",
      "what": "the branch push carrying the release commit"
    },
    {
      "id": "dataset-schema-doc",
      "producer": "scripts/release-and-tag.sh",
      "signature": "npm run dataset:schema",
      "what": "docs/dataset-schema.json regenerated from the imported seed, so the dataset-schema lane holds on main after a release that moves the data"
    },
    {
      "id": "git-tag",
      "producer": "scripts/release-and-tag.sh",
      "signature": "git tag -a",
      "what": "the annotated vX.Y.Z tag"
    },
    {
      "id": "github-release",
      "producer": "scripts/release-and-tag.sh",
      "signature": "gh release create",
      "what": "the GitHub Release, with the APK attached and a body built from the commit list"
    },
    {
      "id": "install-preamble",
      "producer": "scripts/release-and-tag.sh",
      "signature": "install_preamble",
      "what": "869f13d5t. The install explanation in the release body, EN + EL, above the commit list - for a reader who has no app yet and so cannot read the /supported screen"
    },
    {
      "id": "measured-figures",
      "producer": "scripts/release-and-tag.sh",
      "signature": "check-dataset-measurements.mjs\" --app-root \"${PROJECT_ROOT}\" --write",
      "what": "the figures source comments quote with [@dataset] markers, moved to the new measurements - the numbers only, never the words"
    },
    {
      "id": "offline-pack-contract",
      "producer": "scripts/release-and-tag.sh",
      "signature": "npm run packs:contract",
      "what": "docs/offline-pack-contract.json regenerated from the packs the import refreshed"
    },
    {
      "id": "pages-deploy",
      "producer": ".github/workflows/release-android.yml",
      "signature": "npm run build:pages",
      "what": "the Pages rebuild from the release commit, so the UI finally shows the new version"
    },
    {
      "id": "provenance-report",
      "producer": ".github/workflows/release-android.yml",
      "signature": "Write release provenance report",
      "what": "the release provenance report, uploaded as an artifact"
    },
    {
      "id": "regenerated-dataset",
      "producer": "scripts/release-and-tag.sh",
      "signature": "npm run data:import:all",
      "what": "the regenerated dataset files, committed straight to main"
    },
    {
      "id": "signed-apk",
      "producer": "scripts/release-and-tag.sh",
      "signature": "assembleRelease",
      "what": "the signed APK"
    },
    {
      "id": "tag-push",
      "producer": "scripts/release-and-tag.sh",
      "signature": "git push origin \"${RELEASE_TAG}\"",
      "what": "the tag push"
    },
    {
      "id": "version-commit",
      "producer": "scripts/release-and-tag.sh",
      "signature": "git commit -m \"release:",
      "what": "the release: vX.Y.Z commit"
    }
  ],
  "manualOutputs": [
    {
      "id": "github-release-body-summary",
      "what": "the summaryEn paragraph pasted above the generated commit list",
      "detectedBy": "nothing at all - it is simply missing, and only a reader notices",
      "notProducedBy": [
        "scripts/release-and-tag.sh",
        ".github/workflows/release-android.yml"
      ]
    },
    {
      "id": "whats-new-entry",
      "what": "the release's entry at the top of src/app/core/data/whats-new.data.ts",
      "detectedBy": "the whats-new lane, which goes red on main AFTER the bump",
      "notProducedBy": [
        "scripts/release-and-tag.sh",
        ".github/workflows/release-android.yml"
      ]
    }
  ],
  "appConfigByBuildTarget": {
    "note": "Generated from scripts/write-app-config.mjs, package.json and .github/workflows/. Names where each key comes from and whether it is empty - never a value. Whether a named secret exists is GitHub state, not repository state: see docs/release-secrets-register.md.",
    "writer": "scripts/write-app-config.mjs",
    "keys": [
      {
        "key": "ga4MeasurementId",
        "variable": "APP_GA4_MEASUREMENT_ID",
        "whenNotSupplied": "empty"
      },
      {
        "key": "googleDriveBackendUrl",
        "variable": "APP_GOOGLE_DRIVE_BACKEND_URL",
        "whenNotSupplied": "empty"
      },
      {
        "key": "googleDriveFolderName",
        "variable": "APP_GOOGLE_DRIVE_FOLDER_NAME",
        "whenNotSupplied": "the writer's default, not empty"
      },
      {
        "key": "googleIosClientId",
        "variable": "APP_GOOGLE_IOS_CLIENT_ID",
        "whenNotSupplied": "empty"
      },
      {
        "key": "googleWebClientId",
        "variable": "APP_GOOGLE_WEB_CLIENT_ID",
        "whenNotSupplied": "empty"
      }
    ],
    "gates": [
      {
        "key": "googleIosClientId",
        "flag": "--require-google-ios-client-id",
        "variable": "APP_REQUIRE_GOOGLE_IOS_CLIENT_ID"
      },
      {
        "key": "googleWebClientId",
        "flag": "--require-google-web-client-id",
        "variable": "APP_REQUIRE_GOOGLE_WEB_CLIENT_ID"
      }
    ],
    "targets": [
      {
        "id": "website",
        "label": "Website",
        "what": "optcteambuilder.com - built on every push to main and again by every release",
        "reachesPlayers": true,
        "buildScript": "build:pages",
        "writerRunBy": [
          "config:app:web-strict"
        ],
        "steps": [
          {
            "workflow": ".github/workflows/deploy-pages.yml",
            "job": "build",
            "step": "Build GitHub Pages artifact",
            "environment": "github-pages"
          },
          {
            "workflow": ".github/workflows/release-android.yml",
            "job": "deploy-pages",
            "step": "Build GitHub Pages artifact",
            "environment": "github-pages"
          }
        ],
        "requires": [
          {
            "key": "googleWebClientId",
            "by": "--require-google-web-client-id"
          }
        ],
        "keys": {
          "ga4MeasurementId": "secret APP_GA4_MEASUREMENT_ID",
          "googleDriveBackendUrl": "nothing - empty",
          "googleDriveFolderName": "nothing - the writer's default",
          "googleIosClientId": "secret APP_GOOGLE_IOS_CLIENT_ID",
          "googleWebClientId": "secret APP_GOOGLE_WEB_CLIENT_ID"
        }
      },
      {
        "id": "apk",
        "label": "APK",
        "what": "the signed APK attached to each GitHub Release",
        "reachesPlayers": true,
        "buildScript": "build:ionic",
        "writerRunBy": [
          "config:app"
        ],
        "steps": [
          {
            "workflow": ".github/workflows/release-android.yml",
            "job": "release",
            "step": "Run Android release",
            "environment": null
          }
        ],
        "requires": [],
        "keys": {
          "ga4MeasurementId": "nothing - empty",
          "googleDriveBackendUrl": "nothing - empty",
          "googleDriveFolderName": "nothing - the writer's default",
          "googleIosClientId": "nothing - empty",
          "googleWebClientId": "nothing - empty"
        }
      },
      {
        "id": "guide-discoverability",
        "label": "Guide discoverability build",
        "what": "a verification build, checked and discarded",
        "reachesPlayers": false,
        "buildScript": "build:pages",
        "writerRunBy": [
          "config:app:web-strict"
        ],
        "steps": [
          {
            "workflow": ".github/workflows/guide-discoverability.yml",
            "job": "verify",
            "step": "Build GitHub Pages artifact",
            "environment": null
          }
        ],
        "requires": [
          {
            "key": "googleWebClientId",
            "by": "--require-google-web-client-id"
          }
        ],
        "keys": {
          "ga4MeasurementId": "secret APP_GA4_MEASUREMENT_ID",
          "googleDriveBackendUrl": "nothing - empty",
          "googleDriveFolderName": "nothing - the writer's default",
          "googleIosClientId": "secret APP_GOOGLE_IOS_CLIENT_ID",
          "googleWebClientId": "secret APP_GOOGLE_WEB_CLIENT_ID, else a fallback written in the workflow"
        }
      },
      {
        "id": "pwa-cache-freshness",
        "label": "PWA cache-freshness build",
        "what": "a verification build, checked and discarded",
        "reachesPlayers": false,
        "buildScript": "build:pages",
        "writerRunBy": [
          "config:app:web-strict"
        ],
        "steps": [
          {
            "workflow": ".github/workflows/deploy-pages.yml",
            "job": "cache-freshness",
            "step": "Verify PWA cache freshness",
            "environment": "github-pages"
          }
        ],
        "requires": [
          {
            "key": "googleWebClientId",
            "by": "--require-google-web-client-id"
          }
        ],
        "keys": {
          "ga4MeasurementId": "secret APP_GA4_MEASUREMENT_ID",
          "googleDriveBackendUrl": "nothing - empty",
          "googleDriveFolderName": "nothing - the writer's default",
          "googleIosClientId": "secret APP_GOOGLE_IOS_CLIENT_ID",
          "googleWebClientId": "secret APP_GOOGLE_WEB_CLIENT_ID"
        }
      }
    ]
  }
}
