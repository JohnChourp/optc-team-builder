# Copy this file to .env.local for local development.
# Values already present in the shell environment take precedence.

APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
APP_GOOGLE_DRIVE_FOLDER_NAME=OPTC Team Builder
APP_GOOGLE_DRIVE_BACKEND_URL=http://localhost:8787
APP_GOOGLE_WEB_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
APP_GOOGLE_IOS_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# Server-side Google Drive sync. Required when APP_GOOGLE_DRIVE_BACKEND_URL is set.
APP_ORIGIN=http://localhost:4200
DRIVE_SYNC_PUBLIC_BASE_URL=http://localhost:8787
GOOGLE_OAUTH_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback
DRIVE_SYNC_SESSION_SECRET=replace-with-a-long-random-string
DRIVE_SYNC_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string
