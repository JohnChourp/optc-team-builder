/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    /* The two global `vi.mock` factories. Excluded, they were never type-checked,
       so a plugin API change turned a global mock into a silent no-op instead of
       failing to compile - and the build printed a warning about it on every run. */
    "src/test-setup.ts",
    "src/test-mocks/**/*.ts"
  ]
}
