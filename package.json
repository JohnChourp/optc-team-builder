{
  "name": "optc-team-builder",
  "version": "0.0.38",
  "scripts": {
    "config:app": "node ./scripts/write-app-config.mjs",
    "config:app:web-strict": "node ./scripts/write-app-config.mjs --require-google-web-client-id",
    "ng": "ng",
    "server:drive-sync": "node ./server/drive-sync-server.mjs",
    "start": "npm run config:app && ng serve",
    "build": "npm run config:app && ng build",
    "build:pages": "npm run config:app:web-strict && ng build --configuration production --base-href / && npm run seo:pages && npm run seo:audit",
    "seo:pages": "node ./scripts/generate-seo-pages.mjs",
    "seo:audit": "node ./scripts/audit-seo-pages.mjs",
    "seo:indexnow": "node ./scripts/submit-indexnow.mjs",
    "watch": "npm run config:app && ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "npm run test:ci:angular-main && npm run test:ci:angular-preferences && npm run test:ci:parser",
    "test:ci:angular-main": "ng test --watch=false --exclude=src/app/core/services/auto-team-builder-ability-parser.spec.ts --exclude=src/app/core/services/analytics-consent.service.spec.ts --exclude=src/app/core/services/character-overrides.service.spec.ts --exclude=src/app/core/services/user-state.service.spec.ts",
    "test:ci:angular-preferences": "ng test --watch=false --include=src/app/core/services/analytics-consent.service.spec.ts && ng test --watch=false --include=src/app/core/services/character-overrides.service.spec.ts && ng test --watch=false --include=src/app/core/services/user-state.service.spec.ts",
    "test:ci:parser": "vitest run src/app/core/services/auto-team-builder-ability-parser.spec.ts --environment node",
    "test:drive-sync-server": "vitest run server/drive-sync-server.spec.mjs",
    "perf:dataset": "node ./scripts/benchmark-dataset.mjs",
    "i18n:extract": "../codex_utilities/Downloads/projects/node_modules/.bin/transloco-keys-manager extract --project optc-team-builder",
    "i18n:find": "../codex_utilities/Downloads/projects/node_modules/.bin/transloco-keys-manager find --project optc-team-builder --translations-path public/i18n",
    "i18n:validate": "node ./scripts/audit-i18n.mjs",
    "data:import:all": "node ./scripts/import-optc-data.mjs --download-images=all",
    "data:apply-manual": "node ./scripts/apply-manual-characters.mjs",
    "data:upsert-manual-character": "node ./scripts/upsert-manual-character.mjs",
    "build:ionic": "npm run build",
    "build:mobile": "npm run build:ionic && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:sync": "npx cap sync android",
    "ios:sync": "npx cap sync ios"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.20",
    "@ionic/angular": "^8.8.5",
    "@jsverse/transloco": "^8.3.0",
    "ionicons": "^8.0.13",
    "lottie-web": "^5.13.0",
    "ngx-lottie": "^21.2.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.5"
  }
}
