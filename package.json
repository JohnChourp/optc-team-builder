{
  "name": "optc-team-builder",
  "version": "0.0.9",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /optc-team-builder/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n:extract": "transloco-keys-manager extract --project optc-team-builder",
    "i18n:find": "transloco-keys-manager find --project optc-team-builder --translations-path public/i18n",
    "i18n:validate": "node ./scripts/audit-i18n.mjs",
    "data:import": "node ./scripts/import-optc-data.mjs",
    "data:apply-manual": "node ./scripts/apply-manual-characters.mjs",
    "data:upsert-manual-character": "node ./scripts/upsert-manual-character.mjs",
    "build:mobile": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:sync": "npx cap sync android",
    "ios:sync": "npx cap sync ios"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.2.6",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/angular": "^8.8.1",
    "@jsverse/transloco": "^8.2.1",
    "ionicons": "^8.0.13",
    "lottie-web": "^5.13.0",
    "ngx-lottie": "^21.2.0",
    "rxjs": "~7.8.0",
    "sql.js": "^1.14.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "^8.1.0",
    "@jsverse/transloco-utils": "^8.2.1",
    "@jsverse/transloco-validator": "^8.2.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
