{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "!/app-config.js"
        ]
      }
    },
    {
      "name": "i18n",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/i18n/*.json"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/brand/**",
          "/*.ico",
          "/*.jpg",
          "/*.png",
          "/*.svg",
          "/*.webp"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "app-config",
      "urls": [
        "/app-config.js"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "1d",
        "timeout": "2s"
      }
    }
  ]
}
